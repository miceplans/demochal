# 백엔드 API 베이스 URL. 비우면 프록시('/api')를 통해 호출한다.
NEXT_PUBLIC_API_URL=

# 백엔드 프록시 대상(next.config.ts rewrites — 개발 폰백: http://localhost:3001, 프로덕션 필수)
API_PROXY_TARGET=

# BIZ 서브도메인/오리진 (proxy.ts — 기본값 'biz')
BIZ_SUBDOMAIN=
BIZ_ORIGIN=

# ADMIN 서브도메인/오리진 (proxy.ts/admin.ts — 기본값 'admin')
ADMIN_SUBDOMAIN=
ADMIN_ORIGIN=

# 사이트 공개 오리진 (biz.ts의 SITE_ORIGIN 폰백용)
NEXT_PUBLIC_SITE_ORIGIN=

# 토스페이먼츠 클라이언트 키 (결제위젯/결제창 — 테스트: test_ck_..., 라이브: live_ck_...)
# 미설정 시 유료 결제 진입 불가(안내 표시). 값은 절대 커밋하지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 검색엔진 소유 확인 토큰 (layout.tsx 메타데이터 — 서버 전용, 미설정 시 태그 생략)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
