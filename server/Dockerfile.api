# Build context is the monorepo root: docker build -f server/Dockerfile.api .
FROM node:20-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY server/package.json server/
RUN pnpm install --frozen-lockfile --filter @semochal/server...
COPY packages/config packages/config
COPY server server
RUN pnpm --filter @semochal/server build
# `server/node_modules` contains symlinks into the workspace's .pnpm store.
# Deploy a self-contained production tree so those links remain valid after
# copying into the slim runtime image.
RUN pnpm --filter @semochal/server deploy --prod /prod

FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /repo/server/dist ./dist
COPY --from=build /repo/server/drizzle ./drizzle
COPY --from=build /repo/server/certs ./certs
COPY --from=build /prod ./

EXPOSE 3001
CMD ["node", "dist/main.js"]
