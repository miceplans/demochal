# ── App ──────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3001

# ── Database (Drizzle) ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/semochal
# Supabase demo/dev deploy (see docs/deploy-vercel-supabase.md): use the
# "Transaction pooler" connection string from Project Settings > Database,
# and append ?sslmode=require, e.g.
# DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
S3_PUBLIC_BUCKET=semochal-public-dev
S3_PRIVATE_BUCKET=semochal-private-dev
# 인증 검증 큐 (로컬 개발 시 비워두면 SQS 비활성)
SQS_VERIFICATIONS_QUEUE_URL=

# ── Payments (토스페이먼츠) ──────────────────────────────────────────────────
TOSS_SECRET_KEY=

# ── Verification APIs ────────────────────────────────────────────────────────
# 네이버클로바 OCR (사업자등록증 등)
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=
# 홈택스 실업급여 자격 확인
NTS_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# 미설정 시 랜덤 생성(세션 재시작마다 무효화) — production에서는 필수
JWT_SECRET=dev-secret-change-me
# 쿠키 크리덴셜 요청을 허용할 브라우저 origin (쉼표로 여러 개 지정 가능)
FRONTEND_ORIGIN=http://localhost:3000
# 이 서버가 외부에서 접근되는 URL (Google OAuth 콜백 등 구성에 사용)
API_PUBLIC_URL=http://localhost:3001

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Register GOOGLE_REDIRECT_URI exactly as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
