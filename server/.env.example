# ── App ──────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=3001

# ── Database (Drizzle) ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/semochal
# Supabase demo/dev deploy (see docs/deploy-vercel-supabase.md): use the
# "Transaction pooler" connection string from Project Settings > Database,
# and append ?sslmode=require, e.g.
# DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?sslmode=require

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
S3_PUBLIC_BUCKET=semochal-public-dev
S3_PRIVATE_BUCKET=semochal-private-dev
# 인증 검증 큐 (로컬 개발 시 비워두면 SQS 비활성)
SQS_VERIFICATIONS_QUEUE_URL=

# ── Service email (AWS SES) ──────────────────────────────────────────────────
# 서비스성 이메일(사업자 인증 결과·팀 매칭) 발신 주소. 비워두면 이메일 워커가
# no-op하고 DB 알림만 생성된다. 발신 도메인은 SES에서 별도 검증이 필요하다:
# https://docs.aws.amazon.com/ses/latest/dg/creating-identities.html
SES_FROM_EMAIL=
# 이메일 전용 SQS 큐 (로컬 개발 시 비워두면 이메일 발송 비활성)
SQS_EMAILS_QUEUE_URL=
# public 버킷 앞단 CloudFront 도메인. ready 상태 public 파일/광고 이미지의
# 전체 URL을 구성하는 데 쓰인다 (files.service.ts/ads.service.ts). 로컬
# 개발에서는 비워두면 files/ads 응답의 url 필드가 null로 내려간다.
PUBLIC_ASSETS_BASE_URL=

# ── Payments (토스페이먼츠) ──────────────────────────────────────────────────
TOSS_SECRET_KEY=

# ── Verification APIs ────────────────────────────────────────────────────────
# 네이버클로바 OCR (사업자등록증 등)
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=
# 홈택스 실업급여 자격 확인
NTS_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# 미설정 시 랜덤 생성(세션 재시작마다 무효화) — production에서는 필수
JWT_SECRET=dev-secret-change-me
# 쿠키 크리덴셜 요청을 허용할 브라우저 origin (쉼표로 여러 개 지정 가능)
FRONTEND_ORIGIN=http://localhost:3000
# 이 서버가 외부에서 접근되는 URL. Google OAuth 콜백 URI는 GOOGLE_REDIRECT_URI로 별도 설정하며,
# 이 값은 현재 라이브 경로에서는 미사용(예약)입니다.
API_PUBLIC_URL=http://localhost:3001

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
# Register GOOGLE_REDIRECT_URI exactly as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Naver OAuth 2.0 (네이버 개발자센터 > 내 애플리케이션)
# Register NAVER_REDIRECT_URI exactly as the registered Callback URL.
# Production: https://server.semochall.com/auth/social/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:3001/auth/social/naver/callback
